rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function reading(r) {
   return r is map && r.keys().hasOnly(['sys','dia','pulse'])
    && r.sys is int && r.sys >= 40 && r.sys <= 300
    && r.dia is int && r.dia >= 20 && r.dia <= 200 && r.sys > r.dia
    && r.pulse is int && r.pulse >= 20 && r.pulse <= 250;
  }
  function valid(id) {
   let d = request.resource.data;
   return d.keys().hasAll(['id','blockStart','datetime','period','readings','note'])
    && d.keys().hasOnly(['id','blockStart','datetime','period','readings','note'])
    && d.id == id && d.id is string && d.id.size() <= 100
    && d.blockStart is string && d.blockStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.datetime is string && d.datetime.size() <= 40
    && d.period in ['morgen','aften']
    && d.note is string && d.note.size() <= 1000
    && d.readings is list && d.readings.size() == 3
    && reading(d.readings[0]) && reading(d.readings[1]) && reading(d.readings[2]);
  }
  match /users/{uid}/sessions/{id} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && valid(id);
  }
 }
}
